post_install() {
    echo "The cuda binaries are in /opt/cuda-11.8/bin"
    echo "The cuda docs are in /opt/cuda-11.8/doc"
    echo "You need to relogin in order for the cuda binaries to appear in your PATH"
    echo "(or source /etc/profile.d/cuda.sh)"
    post_upgrade
}

post_upgrade() {
    ldconfig -r .
}
