# Copy to .env and fill in real values. NEVER commit .env.
#
# Fine-grained GitHub PAT (repo: fufurobot/cuda11.8).
# Required permissions: Contents (read/write), Issues (read/write),
# Pull requests (read/write), Actions (read) for CI status.
GITHUB_TOKEN=
GITHUB_OWNER=fufurobot
GITHUB_REPO=fufurobot/cuda11.8
# Alternate (non-public) secret filename required by the .env spec:
# tools must read this instead of .env where a distinct name is needed.
CUDA_AUR_SECRETS_FILE=.env
