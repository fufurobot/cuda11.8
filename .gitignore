# --- Secrets (NEVER commit) -------------------------------------------------
# Real credentials live in .env; .env.example documents the shape with all
# sensitive values erased.
.env
.env.*
!.env.example

# Build artifacts produced by makepkg
*.pkg.tar.*
*.pkg.tar.zst
pkg/
src/
*.tar.gz
*.tar.xz
*.tar.zst
*.zip

# Python / uv (dev tooling: playwright, pyautogui)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# CI / test scratch output
.cache/
dist/
build/
out/
reports/
*.log

# Editor / OS noise
*.swp
*~
.DS_Store
.idea/
.vscode/

# uv cache / playwright browsers staged inside the workspace
.uv-cache/
.pw-browsers/
uv.lock

# makepkg stages PKGBUILD sources in the project directory. The CUDA installer
# is ~4.3 GB and any split parts are ~2 GB each; committing either blows past
# GitHub's 2 GiB pack limit and the push is rejected outright.
cuda_*_linux.run
cuda_*_linux.run.part*
*.pkg.tar.zst.part-*
release-assets/
